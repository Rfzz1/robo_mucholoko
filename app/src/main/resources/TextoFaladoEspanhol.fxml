<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    fx:id="painelPrincipal"
    prefHeight="768.0"
    prefWidth="1366.0"
    minHeight="768.0"
    minWidth="1366.0"
    maxHeight="768.0"
    maxWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.SegundaPagina">

    <children>

        <!-- LOGO CENTRAL -->
        <ImageView
            fitHeight="640.0"
            fitWidth="640.0"
            layoutX="363.0"
            layoutY="64.0"
            pickOnBounds="true"
            preserveRatio="true">

            <image>
                <Image url="@img/logo.png" />
            </image>

        </ImageView>


        <!-- FUNDO ESCURO -->
        <Pane
            prefHeight="768.0"
            prefWidth="1366.0"
            style="-fx-background-color: #000000;"
            opacity="0.25" />


        <!-- CAIXA DA MENSAGEM -->
        <Pane
            layoutX="256.0"
            layoutY="213.0"
            prefHeight="341.0"
            prefWidth="853.0"
            style="-fx-background-color: #0000b7;
                   -fx-background-radius: 32px;">

            <children>

                <Text
                    fill="WHITE"
                    layoutX="43.0"
                    layoutY="71.0"
                    wrappingWidth="768.0"
                    text="Hola, bienvenido al CEIT. Estoy aquí para ayudarte a orientarte y a obtener más información sobre nuestros servicios y actividades; siéntete como en casa y espero que disfrutes de mi atención."
                    textAlignment="CENTER">

                    <font>
                        <Font
                            name="System Bold"
                            size="34.1" />
                    </font>

                </Text>

            </children>

        </Pane>

    </children>

</Pane>

