<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="768.0"
    maxWidth="1366.0"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.controllers.Senai">

    <children>

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Pane
            layoutX="0.0"
            layoutY="0.0"
            prefHeight="110.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

            <children>

                <ImageView
                    fitHeight="75.0"
                    fitWidth="90.0"
                    layoutX="20.0"
                    layoutY="17.0"
                    pickOnBounds="true"
                    preserveRatio="true">

                    <image>
                        <Image url="@../Senai_Pequeno/fundoT.png"/>
                    </image>

                </ImageView>

                <Label
                    layoutX="625.0"
                    layoutY="17.0"
                    text="SENAI"
                    textFill="WHITE">

                    <font>
                        <Font
                            name="Candara Bold"
                            size="68.0"/>
                    </font>

                </Label>

            </children>
        </Pane>


        <!-- ========================= -->
<!-- PAINEL DE INFORMAÇÕES -->
<!-- ========================= -->

<Pane
    layoutX="45.0"
    layoutY="140.0"
    prefHeight="485.0"
    prefWidth="610.0"
    style="-fx-background-color: #ffffff;
           -fx-background-radius: 30px;">

    <children>

        <VBox
            layoutX="35.0"
            layoutY="25.0"
            prefWidth="540.0"
            prefHeight="435.0"
            spacing="18.0">

            <children>

                <!-- INTRODUÇÃO -->

                <Text
                    fill="#0000b7"
                    wrappingWidth="540.0"
                    text="CEIT, en colaboración con SENAI, ofrece tres programas de formación profesional, proporcionando a los estudiantes conocimientos y experiencia en diferentes áreas.">

                    <font>
                        <Font
                            name="Candara"
                            size="24.0"/>
                    </font>

                </Text>


                <!-- CURSOS -->

                <VBox
                    prefWidth="530.0"
                    spacing="14.0">

                    <children>

                        <!-- CURSO 1 -->

                        <Text
                            fill="#0000b7"
                            wrappingWidth="530.0"
                            text="→ Técnico en Desarrollo de Sistemas">

                            <font>
                                <Font
                                    name="Candara Bold"
                                    size="23.0"/>
                            </font>

                        </Text>


                        <!-- CURSO 2 -->

                        <Text
                            fill="#0000b7"
                            wrappingWidth="530.0"
                            text="→ Técnico en Robótica y Mecatrónica">

                            <font>
                                <Font
                                    name="Candara Bold"
                                    size="23.0"/>
                            </font>

                        </Text>


                        <!-- CURSO 3 -->

                        <Text
                            fill="#0000b7"
                            wrappingWidth="530.0"
                            text="→ Aprendizaje en Transformación de Polímeros">

                            <font>
                                <Font
                                    name="Candara Bold"
                                    size="23.0"/>
                            </font>

                        </Text>

                    </children>

                </VBox>


                <!-- TEXTO FINAL -->

                <Text
                    fill="#0000b7"
                    wrappingWidth="540.0"
                    text="Cada programa se enfoca en un área de especialización diferente y ofrece oportunidades para desarrollar habilidades profesionales.">

                    <font>
                        <Font
                            name="Candara"
                            size="22.0"/>
                    </font>

                </Text>

            </children>

        </VBox>

    </children>

</Pane>


        <!-- ========================= -->
        <!-- TÍTULO DOS PROGRAMAS -->
        <!-- ========================= -->

        <Text
            fill="#0000b7"
            layoutX="710.0"
            layoutY="165.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="¿Quieres saber más?"
            wrappingWidth="590.0">

            <font>
                <Font
                    name="Candara Bold"
                    size="36.0"/>
            </font>

        </Text>


        <Text
            fill="#0000b7"
            layoutX="710.0"
            layoutY="215.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="¡Mira los videos y descubre un poco más sobre cada programa!"
            wrappingWidth="590.0">

            <font>
                <Font
                    name="Candara"
                    size="24.0"/>
            </font>

        </Text>


        <!-- ========================= -->
        <!-- CURSO 1 -->
        <!-- ========================= -->

        <Button
            layoutX="700.0"
            layoutY="275.0"
            mnemonicParsing="false"
            prefHeight="65.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Técnico en Desarrollo de Sistemas"
            textFill="WHITE"
            onAction="#abrirDesenvolvimentoSistemas">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- CURSO 2 -->
        <!-- ========================= -->

        <Button
            layoutX="700.0"
            layoutY="370.0"
            mnemonicParsing="false"
            prefHeight="65.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Técnico en Robótica y Mecatrónica"
            textFill="WHITE"
            onAction="#abrirMecatronica">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- CURSO 3 -->
        <!-- ========================= -->

        <Button
            layoutX="700.0"
            layoutY="465.0"
            mnemonicParsing="false"
            prefHeight="65.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Aprendizaje en Transformación de Polímeros"
            textFill="WHITE"
            onAction="#abrirPolimeros">

            <font>
                <Font
                    name="Candara Bold"
                    size="23.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- VOLTAR -->
        <!-- ========================= -->

        <Button
            layoutX="700.0"
            layoutY="565.0"
            mnemonicParsing="false"
            prefHeight="58.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #ff751f;"
            text="Volver"
            textFill="WHITE"
            onAction="#voltar">

            <font>
                <Font
                    name="Candara Bold"
                    size="27.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- CRÉDITOS -->
        <!-- ========================= -->

        <Label
            layoutX="45.0"
            layoutY="735.0"
            text="Créditos de desarrollo: Bianca Steffani y Júlia Weber. Créditos de edición: Eduardo Brinckmann, Rafael Domingues y Rafaela Cislaghi."
            textFill="#0000b7">

            <font>
                <Font
                    name="Candara Bold"
                    size="11.0"/>
            </font>

        </Label>

    </children>

</Pane>
