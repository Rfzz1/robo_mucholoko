<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="768.0"
    maxWidth="1366.0"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.Senai">

   <children>

      <!-- ========================= -->
      <!-- CABEÇALHO -->
      <!-- ========================= -->

      <Pane
          prefHeight="134.0"
          prefWidth="1366.0"
          style="-fx-background-color: #0000b7;">

         <children>

            <ImageView
                fitHeight="85.0"
                fitWidth="105.0"
                layoutX="20.0"
                layoutY="10.0"
                pickOnBounds="true"
                preserveRatio="true">

               <image>
                  <Image url="@../Senai_Pequeno/fundoT.png"/>
               </image>

            </ImageView>

            <Label
                layoutX="610.0"
                layoutY="18.0"
                text="SENAI"
                textFill="WHITE">

               <font>
                  <Font name="Cambria Bold" size="72.0"/>
               </font>

            </Label>

         </children>
      </Pane>


      <!-- ========================= -->
      <!-- PAINEL ESQUERDO -->
      <!-- ========================= -->

      <Pane
          layoutX="25.0"
          layoutY="160.0"
          prefHeight="490.0"
          prefWidth="650.0"
          style="-fx-background-color: #ffff; -fx-background-radius: 30px;">

         <children>

            <Text
                fill="#0000b7"
                layoutX="35.0"
                layoutY="58.0"
                strokeType="OUTSIDE"
                strokeWidth="0.0"
                text="O CEIT, em colaboração com o SENAI, oferece três programas de formação profissional, proporcionando aos estudantes conhecimentos e experiência em diferentes áreas:"
                wrappingWidth="580.0">

               <font>
                  <Font name="Candara" size="27.0"/>
               </font>

            </Text>


            <Text
                fill="#0000b7"
                layoutX="55.0"
                layoutY="255.0"
                strokeType="OUTSIDE"
                strokeWidth="0.0"
                text="-&gt; Técnico em Desenvolvimento de Sistemas;"
                wrappingWidth="550.0">

               <font>
                  <Font name="Candara Bold" size="27.0"/>
               </font>

            </Text>


            <Text
                fill="#0000b7"
                layoutX="55.0"
                layoutY="320.0"
                strokeType="OUTSIDE"
                strokeWidth="0.0"
                text="-&gt; Técnico em Robótica e Mecatrônica;"
                wrappingWidth="550.0">

               <font>
                  <Font name="Candara Bold" size="27.0"/>
               </font>

            </Text>


            <Text
                fill="#0000b7"
                layoutX="55.0"
                layoutY="385.0"
                strokeType="OUTSIDE"
                strokeWidth="0.0"
                text="-&gt; Aprendizagem em Transformação de Polímeros."
                wrappingWidth="550.0">

               <font>
                  <Font name="Candara Bold" size="27.0"/>
               </font>

            </Text>


            <Text
                fill="#0000b7"
                layoutX="35.0"
                layoutY="450.0"
                strokeType="OUTSIDE"
                strokeWidth="0.0"
                text="Cada programa se concentra em uma área de especialização diferente e oferece oportunidades para desenvolver habilidades profissionais."
                wrappingWidth="580.0">

               <font>
                  <Font name="Candara" size="27.0"/>
               </font>

            </Text>

         </children>
      </Pane>


      <!-- ========================= -->
      <!-- TEXTO DIREITO -->
      <!-- ========================= -->

      <Text
          fill="#0000b7"
          layoutX="735.0"
          layoutY="205.0"
          strokeType="OUTSIDE"
          strokeWidth="0.0"
          text="Quer saber mais? Assista aos vídeos e conheça um pouco mais sobre cada curso!"
          wrappingWidth="560.0">

         <font>
            <Font name="Candara Bold" size="30.0"/>
         </font>

      </Text>


      <!-- ========================= -->
      <!-- DESENVOLVIMENTO -->
      <!-- ========================= -->

      <Button
          layoutX="735.0"
          layoutY="285.0"
          mnemonicParsing="false"
          prefHeight="60.0"
          prefWidth="590.0"
          style="-fx-background-radius: 30px; -fx-background-color: #0000b7;"
          text="Técnico em Desenvolvimento de Sistemas"
          textFill="WHITE"
          onAction="#abrirDesenvolvimentoSistemas">

         <font>
            <Font name="Candara Bold" size="27.0"/>
         </font>

      </Button>


      <!-- ========================= -->
      <!-- MECATRÔNICA -->
      <!-- ========================= -->

      <Button
          layoutX="735.0"
          layoutY="370.0"
          mnemonicParsing="false"
          prefHeight="60.0"
          prefWidth="590.0"
          style="-fx-background-radius: 30px; -fx-background-color: #0000b7;"
          text="Técnico em Mecatrônica e Robótica"
          textFill="WHITE"
          onAction="#abrirMecatronica">

         <font>
            <Font name="Candara Bold" size="27.0"/>
         </font>

      </Button>


      <!-- ========================= -->
      <!-- POLÍMEROS -->
      <!-- ========================= -->

      <Button
          layoutX="735.0"
          layoutY="455.0"
          mnemonicParsing="false"
          prefHeight="60.0"
          prefWidth="590.0"
          style="-fx-background-radius: 30px; -fx-background-color: #0000b7;"
          text="Aprendizagem em Transformação de Polímeros"
          textFill="WHITE"
          onAction="#abrirPolimeros">

         <font>
            <Font name="Candara Bold" size="25.0"/>
         </font>

      </Button>


      <!-- ========================= -->
      <!-- VOLTAR -->
      <!-- ========================= -->

      <Button
          layoutX="735.0"
          layoutY="555.0"
          mnemonicParsing="false"
          prefHeight="60.0"
          prefWidth="590.0"
          style="-fx-background-radius: 30px; -fx-background-color: #ff751f;"
          text="Voltar"
          textFill="WHITE"
          onAction="#voltar">

         <font>
            <Font name="Candara Bold" size="32.0"/>
         </font>

      </Button>


      <!-- ========================= -->
      <!-- CRÉDITOS -->
      <!-- ========================= -->

      <Label
          layoutX="25.0"
          layoutY="735.0"
          text="Créditos de desenvolvimento: Bianca Steffani e Júlia Weber.  Créditos de montagem: Eduardo Brinckmann, Rafael Domingues e Rafaela Cislaghi."
          textFill="#0000b7">

         <font>
            <Font name="Candara Bold" size="12.0"/>
         </font>

      </Label>

   </children>
</Pane>