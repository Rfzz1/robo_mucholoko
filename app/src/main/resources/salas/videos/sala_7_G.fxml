<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="768.0"
      prefWidth="1366.0"
      style="-fx-background-color: #dfdfeb;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.VideoSala">

   <children>

      <!-- ================================================= -->
      <!-- FAIXA AZUL DO TÍTULO -->
      <!-- ================================================= -->
      <Pane prefHeight="115.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

         <children>
            <Label layoutX="0.0"
                   layoutY="10.0"
                   prefHeight="95.0"
                   prefWidth="1366.0"
                   alignment="CENTER"
                   text="Sala 7"
                   textFill="WHITE">
               <font>
                  <Font name="Sitka Banner Bold" size="70.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- ================================================= -->
      <!-- LOGO TRAMONTINA -->
      <!-- ================================================= -->
      <ImageView fitHeight="500.0"
                 fitWidth="540.0"
                 layoutX="413.0"
                 layoutY="90.0"
                 pickOnBounds="true"
                 preserveRatio="true"
                 style="background: #dfdfeb;">

         <image>
            <Image url="@../../Downloads/fundoT.png" />
         </image>

      </ImageView>

      <!-- ================================================= -->
      <!-- ÁREA DO VÍDEO -->
      <!-- ================================================= -->
      <Pane layoutX="80.0"
            layoutY="145.0"
            prefHeight="540.0"
            prefWidth="1206.0"
            style="-fx-background-color: black; -fx-background-radius: 10px;">

         <children>
            <MediaView fx:id="videoView"
                       fitHeight="540.0"
                       fitWidth="1206.0"
                       layoutX="0.0"
                       layoutY="0.0"
                       preserveRatio="false"
                       smooth="true" />
         </children>

      </Pane>

      <!-- ================================================= -->
      <!-- NOME DO VÍDEO -->
      <!-- ================================================= -->
      <Label fx:id="caminhoVideo"
             text="sala7.mp4"
             visible="false" />

      <!-- ================================================= -->
      <!-- CRÉDITOS -->
      <!-- ================================================= -->
      <Label layoutX="40.0"
             layoutY="710.0"
             prefWidth="1080.0"
             wrapText="true"
             text="Créditos de Desenvolvimento: Bianca Steffani e Júlia Weber. Créditos da montagem: Eduardo Brinckmann, Rafael Domingues e Rafaela Cislaghi."
             textFill="#0000b7">

         <font>
            <Font name="Candara Bold" size="14.0" />
         </font>

      </Label>

      <!-- ================================================= -->
      <!-- BOTÃO VOLTAR -->
      <!-- ================================================= -->
      <Button layoutX="1200.0"
              layoutY="705.0"
              mnemonicParsing="false"
              onAction="#voltarParaLocalizarSalas"
              prefHeight="40.0"
              prefWidth="125.0"
              style="-fx-background-radius: 30px; -fx-background-color: #ff751f;"
              text="Voltar"
              textFill="WHITE">

         <font>
            <Font name="Candara Bold" size="18.0" />
         </font>

      </Button>

   </children>
</Pane>
