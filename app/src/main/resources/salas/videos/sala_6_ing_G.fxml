<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="768.0"
      prefWidth="1366.0"
      style="-fx-background-color: #dfdfeb;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.VideoSala">

   <children>

      <!-- ================================================= -->
      <!-- BLUE TITLE BAR -->
      <!-- ================================================= -->
      <Pane prefHeight="110.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

         <children>
            <Label layoutX="0.0"
                   layoutY="10.0"
                   prefHeight="90.0"
                   prefWidth="1366.0"
                   alignment="CENTER"
                   text="Room 6"
                   textFill="WHITE">

               <font>
                  <Font name="Sitka Banner Bold" size="72.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- ================================================= -->
      <!-- TRAMONTINA LOGO -->
      <!-- ================================================= -->
      <ImageView fitHeight="500.0"
                 fitWidth="540.0"
                 layoutX="826.0"
                 layoutY="100.0"
                 pickOnBounds="true"
                 preserveRatio="true">

         <image>
            <Image url="@../../Downloads/fundoT.png" />
         </image>
      </ImageView>

      <!-- ================================================= -->
      <!-- VIDEO AREA -->
      <!-- ================================================= -->
      <Pane layoutX="50.0"
            layoutY="140.0"
            prefHeight="500.0"
            prefWidth="1266.0"
            style="-fx-background-color: black; -fx-background-radius: 10px;">

         <children>
            <MediaView fx:id="videoView"
                       fitHeight="500.0"
                       fitWidth="1266.0"
                       layoutX="0.0"
                       layoutY="0.0"
                       preserveRatio="false"
                       smooth="true" />
         </children>
      </Pane>

      <!-- ================================================= -->
      <!-- VIDEO NAME -->
      <!-- ================================================= -->
      <Label fx:id="caminhoVideo"
             text="sala6.mp4"
             visible="false" />

      <!-- ================================================= -->
      <!-- CREDITS -->
      <!-- ================================================= -->
      <Label layoutX="50.0"
             layoutY="665.0"
             prefWidth="1050.0"
             wrapText="true"
             text="Development Credits: Bianca Steffani and Júlia Weber. Editing Credits: Eduardo Brinckmann, Rafael Domingues, and Rafaela Cislaghi."
             textFill="#0000b7">

         <font>
            <Font name="Candara Bold" size="16.0" />
         </font>
      </Label>

      <!-- ================================================= -->
      <!-- BACK BUTTON -->
      <!-- ================================================= -->
      <Button layoutX="1160.0"
              layoutY="665.0"
              mnemonicParsing="false"
              prefHeight="45.0"
              prefWidth="150.0"
              style="-fx-background-radius: 30px; -fx-background-color: #ff751f;"
              text="Back"
              textFill="WHITE"
              onAction="#voltarParaLocalizarSalas">

         <font>
            <Font name="Candara Bold" size="22.0" />
         </font>
      </Button>

   </children>
</Pane>