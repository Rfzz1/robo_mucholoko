<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="768.0"
      prefWidth="1366.0"
      style="-fx-background-color: #dfdfeb;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.VideoSala">

   <children>

      <!-- ================================================= -->
      <!-- BLUE TITLE BAR -->
      <!-- ================================================= -->
      <Pane prefHeight="115.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

         <children>

            <Label layoutX="0.0"
                   layoutY="10.0"
                   prefHeight="95.0"
                   prefWidth="1366.0"
                   alignment="CENTER"
                   text="Room 10 - Meeting"
                   textFill="WHITE">

               <font>
                  <Font name="Sitka Banner Bold" size="70.0" />
               </font>

            </Label>

         </children>
      </Pane>


      <!-- ================================================= -->
      <!-- TRAMONTINA LOGO -->
      <!-- ================================================= -->
      <ImageView fitHeight="650.0"
                 fitWidth="700.0"
                 layoutX="333.0"
                 layoutY="90.0"
                 pickOnBounds="true"
                 preserveRatio="true"
                 style="background: #dfdfeb;">

         <image>
            <Image url="@../../Downloads/fundoT.png" />
         </image>

      </ImageView>


      <!-- ================================================= -->
      <!-- VIDEO AREA -->
      <!-- ================================================= -->
      <Pane layoutX="80.0"
            layoutY="145.0"
            prefHeight="550.0"
            prefWidth="1206.0"
            style="-fx-background-color: black; -fx-background-radius: 10px;">

         <children>

            <MediaView fx:id="videoView"
                       fitHeight="550.0"
                       fitWidth="1206.0"
                       layoutX="0.0"
                       layoutY="0.0"
                       preserveRatio="false"
                       smooth="true" />

         </children>
      </Pane>


      <!-- ================================================= -->
      <!-- VIDEO NAME -->
      <!-- ================================================= -->
      <Label fx:id="caminhoVideo"
             text="sala10.mp4"
             visible="false" />


      <!-- ================================================= -->
      <!-- CREDITS -->
      <!-- ================================================= -->
      <Label layoutX="40.0"
             layoutY="715.0"
             prefWidth="1050.0"
             text="Development Credits: Bianca Steffani and Júlia Weber. Editing Credits: Eduardo Brinckmann, Rafael Domingues, and Rafaela Cislaghi."
             textFill="#0000b7">

         <font>
            <Font name="Candara Bold" size="14.0" />
         </font>

      </Label>


      <!-- ================================================= -->
      <!-- BACK BUTTON -->
      <!-- ================================================= -->
      <Button layoutX="1190.0"
              layoutY="710.0"
              mnemonicParsing="false"
              onAction="#voltarParaLocalizarSalas"
              prefHeight="40.0"
              prefWidth="135.0"
              style="-fx-background-radius: 30px; -fx-background-color: #ff751f;"
              text="Back"
              textFill="WHITE">

         <font>
            <Font name="Candara Bold" size="18.0" />
         </font>

      </Button>

   </children>

</Pane>