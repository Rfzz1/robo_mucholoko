<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="-Infinity"
    maxWidth="-Infinity"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.controllers.saidas">

    <children>

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Pane
            layoutX="0.0"
            layoutY="0.0"
            prefHeight="120.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

            <children>

                <Label
                    layoutX="425.0"
                    layoutY="22.0"
                    text="Saídas de emergência"
                    textFill="WHITE">

                    <font>
                        <Font
                            name="Cambria Bold"
                            size="60.0"/>
                    </font>

                </Label>

            </children>

        </Pane>


        <!-- ========================= -->
        <!-- PAINEL DE INFORMAÇÕES -->
        <!-- ========================= -->

        <Pane
            layoutX="55.0"
            layoutY="145.0"
            prefHeight="220.0"
            prefWidth="1256.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;">

            <children>

                <Text
                    fill="WHITE"
                    layoutX="35.0"
                    layoutY="45.0"
                    strokeType="OUTSIDE"
                    strokeWidth="0.0"
                    text="Em caso de emergência, mantenha a calma e siga as orientações de segurança para realizar a evacuação de forma rápida, organizada e segura. Utilize a saída de emergência mais próxima, seguindo as sinalizações e as instruções dos responsáveis pelo local."
                    wrappingWidth="1180.0">

                    <font>
                        <Font
                            name="Candara"
                            size="23.0"/>
                    </font>

                </Text>


                <Text
                    fill="WHITE"
                    layoutX="35.0"
                    layoutY="145.0"
                    strokeType="OUTSIDE"
                    strokeWidth="0.0"
                    text="Para estar preparado, confira os vídeos abaixo, que mostram os caminhos das saídas de emergência e ajudam você a conhecer previamente os trajetos até o ambiente externo do local."
                    wrappingWidth="1180.0">

                    <font>
                        <Font
                            name="Candara"
                            size="23.0"/>
                    </font>

                </Text>

            </children>
        </Pane>


        <!-- ========================= -->
        <!-- SAÍDAS DE EMERGÊNCIA -->
        <!-- ========================= -->

        <!-- ELEVADOR -->

        <Button
            layoutX="55.0"
            layoutY="395.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Saída de emergência próxima ao elevador"
            textFill="WHITE"
            onAction="#abriSaidaproximodoelevador">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- BEM-ESTAR -->

        <Button
            layoutX="55.0"
            layoutY="470.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Saída de emergência Bem-estar"
            textFill="WHITE"
            onAction="#abrirSaidaBemestar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- SEGUNDO ANDAR -->

        <Button
            layoutX="55.0"
            layoutY="545.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Saída de emergência segundo andar"
            textFill="WHITE"
            onAction="#abrirSaidasegundoandar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- AUDITÓRIO -->

        <Button
            layoutX="711.0"
            layoutY="395.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Saída de emergência auditório"
            textFill="WHITE"
            onAction="#abrirsaidaauditorio">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- VOLTAR -->
        <!-- ========================= -->

        <Button
            layoutX="711.0"
            layoutY="470.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #ff751f;"
            text="Voltar"
            textFill="WHITE"
            onAction="#abrirVoltar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- IMAGEM -->
        <!-- ========================= -->

        <ImageView
            fitHeight="145.0"
            fitWidth="150.0"
            layoutX="1120.0"
            layoutY="600.0"
            pickOnBounds="true"
            preserveRatio="true">

            <image>
                <Image url="@ChatGPT%20Image%2025%20de%20ago.%20de%202026,%2016_06_44.png"/>
            </image>

        </ImageView>


        <!-- ========================= -->
        <!-- CRÉDITOS -->
        <!-- ========================= -->

        <Label
            layoutX="40.0"
            layoutY="735.0"
            text="Créditos de desenvolvimento: Bianca Steffani e Júlia Weber. Créditos de montagem: Eduardo Brinckmann, Rafael Domingues e Rafaela Cislaghi."
            textFill="#0000b7">

            <font>
                <Font
                    name="Candara Bold"
                    size="11.0"/>
            </font>

        </Label>

    </children>

</Pane>

