<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="768.0"
    maxWidth="1366.0"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.saidas">

    <children>

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Pane
            layoutX="0.0"
            layoutY="0.0"
            prefHeight="110.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

            <children>

                <Label
                    layoutX="430.0"
                    layoutY="18.0"
                    text="Salidas de emergencia"
                    textFill="WHITE">

                    <font>
                        <Font
                            name="Cambria Bold"
                            size="62.0"/>
                    </font>

                </Label>

            </children>
        </Pane>


        <!-- ========================= -->
        <!-- CAIXA DE INFORMAÇÕES -->
        <!-- ========================= -->

        <Button
            layoutX="100.0"
            layoutY="135.0"
            mnemonicParsing="false"
            prefHeight="190.0"
            prefWidth="1166.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            textFill="WHITE"
            mouseTransparent="true"/>


        <!-- ========================= -->
        <!-- TEXTO PRINCIPAL -->
        <!-- ========================= -->

        <Text
            fill="WHITE"
            layoutX="125.0"
            layoutY="172.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="En caso de emergencia, mantenga la calma y siga las indicaciones de seguridad para realizar la evacuación de forma rápida, organizada y segura. Utilice la salida de emergencia más cercana, siguiendo las señalizaciones y las instrucciones de los responsables del lugar."
            wrappingWidth="1110.0">

            <font>
                <Font
                    name="Candara"
                    size="23.0"/>
            </font>

        </Text>


        <!-- ========================= -->
        <!-- SEGUNDO TEXTO -->
        <!-- ========================= -->

        <Text
            fill="WHITE"
            layoutX="125.0"
            layoutY="275.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="Para estar preparado, consulte los videos a continuación, que muestran las rutas de las salidas de emergencia y le ayudan a familiarizarse con los caminos hacia el exterior del lugar."
            wrappingWidth="1110.0">

            <font>
                <Font
                    name="Candara"
                    size="23.0"/>
            </font>

        </Text>


        <!-- ========================= -->
        <!-- BOTÃO 1 -->
        <!-- ========================= -->

        <Button
            layoutX="80.0"
            layoutY="365.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Salida de emergencia cerca del ascensor"
            textFill="WHITE"
            onAction="#abriSaidaproximodoelevador">

            <font>
                <Font
                    name="Candara Bold"
                    size="24.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- BOTÃO 2 -->
        <!-- ========================= -->

        <Button
            layoutX="706.0"
            layoutY="365.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Salida de emergencia — Bienestar"
            textFill="WHITE"
            onAction="#abrirSaidaBemestar">

            <font>
                <Font
                    name="Candara Bold"
                    size="24.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- BOTÃO 3 -->
        <!-- ========================= -->

        <Button
            layoutX="80.0"
            layoutY="445.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Salida de emergencia — segundo piso"
            textFill="WHITE"
            onAction="#abrirSaidasegundoandar">

            <font>
                <Font
                    name="Candara Bold"
                    size="24.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- BOTÃO 4 -->
        <!-- ========================= -->

        <Button
            layoutX="706.0"
            layoutY="445.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Salida de emergencia — auditorio"
            textFill="WHITE"
            onAction="#abrirsaidaauditorio">

            <font>
                <Font
                    name="Candara Bold"
                    size="24.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- IMAGEM -->
        <!-- ========================= -->

        <ImageView
            fitHeight="145.0"
            fitWidth="260.0"
            layoutX="553.0"
            layoutY="525.0"
            pickOnBounds="true"
            preserveRatio="true">

            <image>
                <Image url="@ChatGPT%20Image%2025%20de%20ago.%20de%202026,%2016_10_18.png"/>
            </image>

        </ImageView>


        <!-- ========================= -->
        <!-- BOTÃO VOLTAR -->
        <!-- ========================= -->

        <Button
            layoutX="483.0"
            layoutY="665.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="400.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #ff751f;"
            text="Volver"
            textFill="WHITE"
            onAction="#abrirVoltar">

            <font>
                <Font
                    name="Candara Bold"
                    size="27.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- CRÉDITOS -->
        <!-- ========================= -->

        <Label
            layoutX="80.0"
            layoutY="738.0"
            text="Créditos de desarrollo: Bianca Steffani y Júlia Weber. Créditos de montaje: Eduardo Brinckmann, Rafael Domingues y Rafaela Cislaghi."
            textFill="#0000b7">

            <font>
                <Font
                    name="Candara Bold"
                    size="11.0"/>
            </font>

        </Label>

    </children>

</Pane>