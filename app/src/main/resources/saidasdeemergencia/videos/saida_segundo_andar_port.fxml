<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.Pane?>

<?import javafx.scene.media.MediaView?>

<?import javafx.scene.text.Font?>

<Pane
 fx:id="painelPrincipal"
 maxHeight="768.0"
 maxWidth="1366.0"
 minHeight="768.0"
 minWidth="1366.0"
 prefHeight="768.0"
 prefWidth="1366.0"
 style="-fx-background-color: #dfdfeb;"
 xmlns="http://javafx.com/javafx/21"
 xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="org.example.SaidaVideoController">

<children>

    <!-- ================================================= -->
    <!-- FAIXA AZUL DO TÍTULO -->
    <!-- ================================================= -->

    <Pane
        layoutX="0.0"
        layoutY="0.0"
        prefWidth="1366.0"
        prefHeight="120.0"
        style="-fx-background-color: #0000b7;">

        <children>

            <Label
                layoutX="30.0"
                layoutY="20.0"
                prefWidth="1306.0"
                prefHeight="80.0"
                alignment="CENTER"
                text="Saída de Emergência do segundo andar"
                textFill="WHITE">

                <font>
                    <Font
                        name="Sitka Banner Bold"
                        size="52.0" />
                </font>

            </Label>

        </children>

    </Pane>


    <!-- ================================================= -->
    <!-- ÁREA DO VÍDEO -->
    <!-- ================================================= -->

    <Pane
        layoutX="100.0"
        layoutY="145.0"
        prefWidth="1166.0"
        prefHeight="500.0"
        style="-fx-background-color: black; -fx-background-radius: 20px;">

        <children>

            <MediaView
                fx:id="videoView"
                layoutX="0.0"
                layoutY="0.0"
                fitWidth="1166.0"
                fitHeight="500.0"
                preserveRatio="false"
                smooth="true" />

        </children>

    </Pane>


    <!-- ================================================= -->
    <!-- NOME DO VÍDEO -->
    <!-- ================================================= -->

    <Label
        fx:id="caminhoVideo"
        text="saida_emergencia_2.mp4"
        visible="false"
        managed="false" />


    <!-- ================================================= -->
    <!-- CRÉDITOS -->
    <!-- ================================================= -->

    <Label
        layoutX="40.0"
        layoutY="710.0"
        prefWidth="900.0"
        text="Créditos de Desenvolvimento: Bianca Steffani e Júlia Weber. Créditos da montagem: Eduardo Brinckmann, Rafael Domingues e Rafaela Cislaghi."
        textFill="#0000b7">

        <font>
            <Font
                name="Candara Bold"
                size="16.0" />
        </font>

    </Label>


    <!-- ================================================= -->
    <!-- BOTÃO VOLTAR -->
    <!-- ================================================= -->

    <Button
        layoutX="1050.0"
        layoutY="700.0"
        mnemonicParsing="false"
        onAction="#abrirVoltaremergencia"
        prefHeight="45.0"
        prefWidth="260.0"
        style="-fx-background-radius: 25px; -fx-background-color: #ff751f;"
        text="Voltar"
        textFill="WHITE">

        <font>
            <Font
                name="Candara Bold"
                size="24.0" />
        </font>

    </Button>

</children>

</Pane>
