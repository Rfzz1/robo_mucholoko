<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="-Infinity"
    maxWidth="-Infinity"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.controllers.saidas">

    <children>

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Pane
            layoutX="0.0"
            layoutY="0.0"
            prefHeight="120.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

            <children>

                <Label
                    layoutX="425.0"
                    layoutY="22.0"
                    text="Emergency exits"
                    textFill="WHITE">

                    <font>
                        <Font
                            name="Cambria Bold"
                            size="60.0"/>
                    </font>

                </Label>

            </children>

        </Pane>

        <!-- ========================= -->
        <!-- PAINEL DE INFORMAÇÕES -->
        <!-- ========================= -->

        <Pane
            layoutX="55.0"
            layoutY="145.0"
            prefHeight="220.0"
            prefWidth="1256.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;">

            <children>

                <Text
                    fill="WHITE"
                    layoutX="35.0"
                    layoutY="45.0"
                    strokeType="OUTSIDE"
                    strokeWidth="0.0"
                    text="In case of an emergency, remain calm and follow the safety instructions to evacuate quickly, orderly, and safely. Use the nearest emergency exit, following the signs and the instructions of the people responsible for the premises."
                    wrappingWidth="1180.0">

                    <font>
                        <Font
                            name="Candara"
                            size="23.0"/>
                    </font>

                </Text>

                <Text
                    fill="WHITE"
                    layoutX="35.0"
                    layoutY="145.0"
                    strokeType="OUTSIDE"
                    strokeWidth="0.0"
                    text="To be prepared, check out the videos below, which show the emergency exit routes and help you become familiar with the paths to the outside of the premises."
                    wrappingWidth="1180.0">

                    <font>
                        <Font
                            name="Candara"
                            size="23.0"/>
                    </font>

                </Text>

            </children>
        </Pane>

        <!-- ========================= -->
        <!-- SAÍDAS DE EMERGÊNCIA -->
        <!-- ========================= -->

        <!-- ELEVADOR -->

        <Button
            layoutX="55.0"
            layoutY="395.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit near the elevator"
            textFill="WHITE"
            onAction="#abriSaidaproximodoelevador">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>

        <!-- BEM-ESTAR -->

        <Button
            layoutX="55.0"
            layoutY="470.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — Wellness"
            textFill="WHITE"
            onAction="#abrirSaidaBemestar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>

        <!-- SEGUNDO ANDAR -->

        <Button
            layoutX="55.0"
            layoutY="545.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — second floor"
            textFill="WHITE"
            onAction="#abrirSaidasegundoandar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>

        <!-- AUDITÓRIO -->

        <Button
            layoutX="711.0"
            layoutY="395.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — auditorium"
            textFill="WHITE"
            onAction="#abrirsaidaauditorio">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>

        <!-- ========================= -->
        <!-- VOLTAR -->
        <!-- ========================= -->

        <Button
            layoutX="711.0"
            layoutY="470.0"
            mnemonicParsing="false"
            prefHeight="55.0"
            prefWidth="600.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #ff751f;"
            text="Back"
            textFill="WHITE"
            onAction="#abrirVoltar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>

        <!-- ========================= -->
        <!-- IMAGEM -->
        <!-- ========================= -->

        <ImageView
            fitHeight="145.0"
            fitWidth="150.0"
            layoutX="1120.0"
            layoutY="600.0"
            pickOnBounds="true"
            preserveRatio="true">

            <image>
                <Image url="@ChatGPT%20Image%2025%20de%20ago.%20de%202026,%2016_10_10.png"/>
            </image>

        </ImageView>

        <!-- ========================= -->
        <!-- CRÉDITOS -->
        <!-- ========================= -->

        <Label
            layoutX="40.0"
            layoutY="735.0"
            text="Development credits: Bianca Steffani and Júlia Weber. Assembly credits: Eduardo Brinckmann, Rafael Domingues, and Rafaela Cislaghi."
            textFill="#0000b7">

            <font>
                <Font
                    name="Candara Bold"
                    size="11.0"/>
            </font>

        </Label>

    </children>

</Pane>