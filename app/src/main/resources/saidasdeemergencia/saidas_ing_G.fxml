<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane
    maxHeight="-Infinity"
    maxWidth="-Infinity"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #dfdfeb;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.saidas">

    <children>

        <!-- ========================= -->
        <!-- CABEÇALHO -->
        <!-- ========================= -->

        <Pane
            layoutX="0.0"
            layoutY="0.0"
            prefHeight="110.0"
            prefWidth="1366.0"
            style="-fx-background-color: #0000b7;">

            <children>

                <Label
                    layoutX="447.0"
                    layoutY="18.0"
                    text="Emergency exits"
                    textFill="WHITE">

                    <font>
                        <Font
                            name="Cambria Bold"
                            size="62.0"/>
                    </font>

                </Label>

            </children>
        </Pane>


        <!-- ========================= -->
        <!-- CAIXA DE INFORMAÇÕES -->
        <!-- ========================= -->

        <Button
            layoutX="100.0"
            layoutY="135.0"
            mnemonicParsing="false"
            prefHeight="210.0"
            prefWidth="1166.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            textFill="WHITE"
            mouseTransparent="true">

            <font>
                <Font
                    name="Candara Bold"
                    size="40.0"/>
            </font>

        </Button>


        <!-- TEXTO 1 -->

        <Text
            fill="WHITE"
            layoutX="125.0"
            layoutY="175.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="In case of an emergency, remain calm and follow the safety instructions to evacuate quickly, orderly, and safely. Use the nearest emergency exit, following the signs and the instructions of the people responsible for the premises."
            wrappingWidth="1110.0">

            <font>
                <Font
                    name="Candara"
                    size="24.0"/>
            </font>

        </Text>


        <!-- TEXTO 2 -->

        <Text
            fill="WHITE"
            layoutX="125.0"
            layoutY="285.0"
            strokeType="OUTSIDE"
            strokeWidth="0.0"
            text="To be prepared, check out the videos below, which show the emergency exit routes and help you become familiar with the paths to the outside of the premises."
            wrappingWidth="1110.0">

            <font>
                <Font
                    name="Candara"
                    size="24.0"/>
            </font>

        </Text>


        <!-- ========================= -->
        <!-- BOTÕES -->
        <!-- ========================= -->

        <Button
            layoutX="80.0"
            layoutY="375.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit near the elevator"
            textFill="WHITE"
            onAction="#abriSaidaproximodoelevador">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <Button
            layoutX="706.0"
            layoutY="375.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — Wellness"
            textFill="WHITE"
            onAction="#abrirSaidaBemestar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <Button
            layoutX="80.0"
            layoutY="460.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — second floor"
            textFill="WHITE"
            onAction="#abrirSaidasegundoandar">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <Button
            layoutX="706.0"
            layoutY="460.0"
            mnemonicParsing="false"
            prefHeight="62.0"
            prefWidth="580.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #0000b7;"
            text="Emergency exit — auditorium"
            textFill="WHITE"
            onAction="#abrirsaidaauditorio">

            <font>
                <Font
                    name="Candara Bold"
                    size="25.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- IMAGEM -->
        <!-- ========================= -->

        <ImageView
            fitHeight="190.0"
            fitWidth="250.0"
            layoutX="558.0"
            layoutY="535.0"
            pickOnBounds="true"
            preserveRatio="true">

            <image>
                <Image url="@ChatGPT%20Image%2025%20de%20ago.%20de%202026,%2016_10_10.png"/>
            </image>

        </ImageView>


        <!-- ========================= -->
        <!-- VOLTAR -->
        <!-- ========================= -->

        <Button
            layoutX="483.0"
            layoutY="650.0"
            mnemonicParsing="false"
            prefHeight="58.0"
            prefWidth="400.0"
            style="-fx-background-radius: 30px;
                   -fx-background-color: #ff751f;"
            text="Back"
            textFill="WHITE"
            onAction="#abrirVoltar">

            <font>
                <Font
                    name="Candara Bold"
                    size="28.0"/>
            </font>

        </Button>


        <!-- ========================= -->
        <!-- CRÉDITOS -->
        <!-- ========================= -->

        <Label
            layoutX="80.0"
            layoutY="735.0"
            text="Development credits: Bianca Steffani and Júlia Weber. Assembly credits: Eduardo Brinckmann, Rafael Domingues, and Rafaela Cislaghi."
            textFill="#0000b7">

            <font>
                <Font
                    name="Candara Bold"
                    size="12.0"/>
            </font>

        </Label>

    </children>

</Pane>
