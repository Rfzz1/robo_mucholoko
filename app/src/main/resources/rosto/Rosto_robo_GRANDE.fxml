<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Ellipse?>

<AnchorPane
    maxHeight="768.0"
    maxWidth="1366.0"
    minHeight="768.0"
    minWidth="1366.0"
    prefHeight="768.0"
    prefWidth="1366.0"
    style="-fx-background-color: #101827;"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.PrimeiraPagina">

    <children>

        <!-- OLHO ESQUERDO -->
        <Ellipse
            fx:id="olhoEsquerdo"
            centerX="295.0"
            centerY="217.0"
            fill="#84C2DF"
            radiusX="103.0"
            radiusY="121.0" />


        <!-- OLHO DIREITO -->
        <Ellipse
            fx:id="olhoDireito"
            centerX="1071.0"
            centerY="217.0"
            fill="#84C2DF"
            radiusX="103.0"
            radiusY="121.0" />


        <!-- BOCA -->
        <Arc
            fx:id="boca"
            centerX="683.0"
            centerY="398.0"
            fill="TRANSPARENT"
            layoutX="0.71"
            layoutY="-84.5"
            length="140.0"
            radiusX="320.0"
            radiusY="245.0"
            startAngle="200.0"
            stroke="#84C2DF"
            strokeLineCap="ROUND"
            strokeWidth="25.6" />


        <!-- BOTÃO INGLÊS -->
        <Button
            fx:id="ButtonEn"
            layoutX="85.4"
            layoutY="672.0"
            mnemonicParsing="false"
            onAction="#AbrirEn"
            prefHeight="58.3"
            prefWidth="284.6"
            style="-fx-background-color: #737B84;
                   -fx-background-radius: 32;
                   -fx-border-color: #84C2DF;
                   -fx-border-width: 3.55;
                   -fx-border-radius: 32;
                   -fx-text-fill: #84C2DF;
                   -fx-font-family: 'Arial';
                   -fx-font-size: 21.3px;
                   -fx-font-weight: bold;"
            text="Start" />


        <!-- BOTÃO PORTUGUÊS -->
        <Button
            fx:id="ButtonPt"
            layoutX="540.5"
            layoutY="672.0"
            mnemonicParsing="false"
            onAction="#AbrirPt"
            prefHeight="58.3"
            prefWidth="284.6"
            style="-fx-background-color: #737B84;
                   -fx-background-radius: 32;
                   -fx-border-color: #84C2DF;
                   -fx-border-width: 3.55;
                   -fx-border-radius: 32;
                   -fx-text-fill: #84C2DF;
                   -fx-font-family: 'Arial';
                   -fx-font-size: 21.3px;
                   -fx-font-weight: bold;"
            text="Começar" />


        <!-- BOTÃO ESPANHOL -->
        <Button
            fx:id="ButtonEsp"
            layoutX="995.8"
            layoutY="672.0"
            mnemonicParsing="false"
            onAction="#AbrirEsp"
            prefHeight="58.3"
            prefWidth="284.6"
            style="-fx-background-color: #737B84;
                   -fx-background-radius: 32;
                   -fx-border-color: #84C2DF;
                   -fx-border-width: 3.55;
                   -fx-border-radius: 32;
                   -fx-text-fill: #84C2DF;
                   -fx-font-family: 'Arial';
                   -fx-font-size: 21.3px;
                   -fx-font-weight: bold;"
            text="Comenzar" />

    </children>

</AnchorPane>
